generator client {
  provider      = "prisma-client-js"
  /// "rhel-openssl-3.0.x" = Vercel functions runtime (Amazon Linux 2023).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  /// Pooled connection in production (Neon/Supabase pooler): serverless functions open many short-lived connections.
  url       = env("DATABASE_URL")
  /// Direct (non-pooled) connection, used by `prisma migrate`.
  directUrl = env("DIRECT_URL")
}

model Household {
  id            String         @id @default(uuid())
  name          String
  inviteCode    String         @unique
  /// TMDB provider ids of the platforms the household subscribes to.
  providerIds   Int[]
  createdAt     DateTime       @default(now())
  members       Member[]
  favorites     Favorite[]
  watched       Watched[]
  matchSessions MatchSession[]
}

model Member {
  id          String      @id @default(uuid())
  householdId String
  household   Household   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name        String
  color       String
  createdAt   DateTime    @default(now())
  sessions    Session[]
  added       Favorite[]  @relation("FavoriteAddedBy")
  personal    Favorite[]  @relation("FavoriteOwner")
  watched     Watched[]
  matchVotes  MatchVote[]
  pairings    DevicePairing[]

  @@unique([householdId, name])
}

/// One per device: an opaque bearer token, stored hashed.
model Session {
  id         String   @id @default(uuid())
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
}

model Favorite {
  id          String    @id @default(uuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  /// `"household"` for the shared list, otherwise the owning member's id
  /// (a plain column rather than a nullable FK so the unique index below holds:
  /// Postgres treats NULLs as distinct).
  listKey     String
  ownerId     String?
  owner       Member?   @relation("FavoriteOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  addedById   String
  addedBy     Member    @relation("FavoriteAddedBy", fields: [addedById], references: [id], onDelete: Cascade)
  mediaType   String
  tmdbId      Int
  createdAt   DateTime  @default(now())

  @@unique([householdId, listKey, mediaType, tmdbId])
  @@index([householdId, listKey, createdAt])
}

/// "Déjà vu": one row per member and title. Binary on purpose (no per-episode tracking).
model Watched {
  id          String    @id @default(uuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  memberId    String
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  mediaType   String
  tmdbId      Int
  createdAt   DateTime  @default(now())

  @@unique([memberId, mediaType, tmdbId])
  @@index([householdId])
}

/// A "Match" evening: shared criteria, every member swipes the same deck.
model MatchSession {
  id          String      @id @default(uuid())
  householdId String
  household   Household   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  /// MatchFilters (mediaType, genres, maxRuntime, minRating), validated by the shared zod schema.
  filters     Json
  createdById String
  createdAt   DateTime    @default(now())
  /// Set when a newer evening is started.
  closedAt    DateTime?
  votes       MatchVote[]

  @@index([householdId, closedAt])
}

model MatchVote {
  id        String       @id @default(uuid())
  sessionId String
  session   MatchSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  mediaType String
  tmdbId    Int
  liked     Boolean
  createdAt DateTime     @default(now())

  @@unique([sessionId, memberId, mediaType, tmdbId])
  @@index([sessionId, mediaType, tmdbId])
}

/// Signing in a new device by QR code: the new device polls with its secret
/// until a signed-in member approves (see PairingService). Short-lived.
model DevicePairing {
  id         String    @id @default(uuid())
  /// The new device's polling secret, stored hashed like session tokens.
  secretHash String    @unique
  /// "Chrome · macOS": shown on the approving device.
  device     String
  /// Set on approval: the member the new device signs in as.
  memberId   String?
  member     Member?   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  approvedAt DateTime?
  /// Set once the new device received its session: a pairing works only once.
  claimedAt  DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([expiresAt])
}
