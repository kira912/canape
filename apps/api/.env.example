# TMDB — https://www.themoviedb.org/settings/api (clé v3 "API Key" ou jeton v4 "API Read Access Token")
TMDB_API_KEY=
# Optionnel — liens directs vers le titre sur chaque plateforme
# https://rapidapi.com/movie-of-the-night-movie-of-the-night-default/api/streaming-availability
STREAMING_AVAILABILITY_API_KEY=
PORT=3333
# Local: both the same. Vercel: DATABASE_URL = pooled URL (…-pooler…, ?pgbouncer=true&connection_limit=1),
# DIRECT_URL = direct URL (migrations).
DATABASE_URL=postgresql://canape:canape@localhost:5434/canape
DIRECT_URL=postgresql://canape:canape@localhost:5434/canape
# IA (recherche en langage naturel, Match assisté) — une seule des deux options suffit.
# Option gratuite : Groq (sans carte bancaire, avec limites de débit) — https://console.groq.com/keys
LLM_API_KEY=
# Optionnel : autre service compatible OpenAI (Gemini, OpenRouter, Cerebras…) et/ou autre modèle
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# Option payante : Claude — https://console.anthropic.com (prioritaire si renseignée)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# Forcer un fournisseur : anthropic | openai-compatible
# LLM_PROVIDER=
# Optionnel : plafond d'appels IA par jour pour toute l'app (défaut 1000 ; 0 = IA coupée)
# AI_DAILY_LIMIT=1000
# Vercel Cron (purge des données inactives) — chaîne aléatoire, ex. `openssl rand -hex 32`
CRON_SECRET=
