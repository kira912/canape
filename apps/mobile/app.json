{
  "expo": {
    "name": "Canapé",
    "slug": "canape",
    "scheme": "canape",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#14111A",
    "icon": "./public/icons/icon-512.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.canape.app",
      "config": { "usesNonExemptEncryption": false }
    },
    "android": {
      "package": "com.canape.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./public/icons/icon-192.png"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
