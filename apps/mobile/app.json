{
  "expo": {
    "name": "Canapé",
    "slug": "canape",
    "scheme": "canape",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#14111A",
    "icon": "./public/icons/icon-512.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.canape.app",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Canapé cherche votre TV connectée sur le Wi-Fi pour y lancer vos plateformes."
      }
    },
    "android": {
      "package": "com.canape.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./public/icons/icon-192.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Canapé utilise la caméra pour scanner le QR code qui connecte un autre appareil à votre profil.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
