{
  "name": "canape",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "pnpm --filter @canape/shared build && pnpm --filter @canape/api start:dev",
    "dev:mobile": "pnpm --filter @canape/mobile start",
    "dev:web": "pnpm --filter @canape/mobile web",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @canape/api prisma:migrate",
    "vercel-build": "pnpm --filter @canape/shared build && pnpm --filter @canape/api exec prisma generate && pnpm --filter @canape/api exec prisma migrate deploy && pnpm --filter @canape/api build && pnpm --filter @canape/mobile build"
  },
  "devDependencies": {
    "typescript": "5.6.3"
  },
  "packageManager": "pnpm@11.25.0"
}
